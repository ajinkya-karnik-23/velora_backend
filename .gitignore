#KB

# Client-supplied data (control definitions, evidence vault, testing outputs,
# report templates) is not part of the application and is not tracked on this
# branch. Point CLIENT_DATA_PATH at your own copy — see .env.example. The app
# starts without it; the client-data screens simply come up empty.
client-data/
poc-2-data/

