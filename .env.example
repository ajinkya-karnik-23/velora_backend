# ─────────────────────────────────────────────────────────────────────────────
# CIQ backend configuration
#
# Copy to .env and fill in the values marked REQUIRED. Everything else has a
# working default for local development.
#
#     cp .env.example .env
#
# Values are read by app/core/config.py (pydantic-settings). Names are
# case-sensitive.
# ─────────────────────────────────────────────────────────────────────────────

# Application
APP_ENV=development
DEBUG=true

# Database — REQUIRED.
# "postgres://" and "postgresql://" are rewritten to the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://ciq_user:ciq_password@localhost:5432/ciq_db
DB_POOL_MIN=5
DB_POOL_MAX=20

# JWT — REQUIRED: JWT_SECRET. Use a long random value outside development.
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Admin bootstrap — REQUIRED. Seeds the first admin user.
ADMIN_EMAIL=admin@ciq.local
ADMIN_PASSWORD=Admin@12345!

# Storage backend: "azure" or "local".
# "local" keeps uploaded evidence on disk under LOCAL_STORAGE_PATH and needs
# no Azure connection string.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage

# Azure Blob Storage — REQUIRED when STORAGE_BACKEND=azure.
# The value below is the well-known Azurite development key.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
AZURE_BLOB_CONTAINER=ciq-evidence

# CORS — must include the frontend origin (Vite dev server is :5173).
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Logging
LOG_LEVEL=INFO

# ─────────────────────────────────────────────────────────────────────────────
# Client-supplied data
#
# The client's own control definitions, evidence and report templates. On this
# POC branch the folder (poc-2-data/) is committed so the demo can be cloned and
# run as-is; a real deployment points CLIENT_DATA_PATH at its own copy instead.
# Expected layout:
#
#   <CLIENT_DATA_PATH>/
#     control_jsons/              control definitions, one JSON per control
#     supporting_documents_dump/  evidence vault, one folder per control number
#     test_outputs/               per-control testing output JSONs
#     misc/                       report templates + the config JSONs below
#       dummy_template.xlsm
#       twp_template_map.json
#       sampling_matrix.json
#       sampling_metadata.json
#       evidence_filename_map.json
#
# Point CLIENT_DATA_PATH at that folder and the rest resolve automatically.
# Absolute paths are fine. The app starts and runs without this data — the
# affected screens simply come up empty.
# ─────────────────────────────────────────────────────────────────────────────
CLIENT_DATA_PATH=poc-2-data

# Individual overrides — only needed when a deployment does not follow the
# layout above. Leave unset to derive them from CLIENT_DATA_PATH.
# SUPPORTING_DOCS_PATH=poc-2-data/supporting_documents_dump
# CONTROL_JSONS_PATH=poc-2-data/control_jsons
# TEST_OUTPUTS_PATH=poc-2-data/test_outputs
# TWP_TEMPLATE_PATH=poc-2-data/misc/dummy_template.xlsm
# TWP_TEMPLATE_MAP_PATH=poc-2-data/misc/twp_template_map.json
# SAMPLING_MATRIX_PATH=poc-2-data/misc/sampling_matrix.json
# SAMPLING_METADATA_PATH=poc-2-data/misc/sampling_metadata.json
# EVIDENCE_FILENAME_MAP_PATH=poc-2-data/misc/evidence_filename_map.json

# ─────────────────────────────────────────────────────────────────────────────
# AI agent pipeline — REQUIRED (the app refuses to start without these).
# Only the control-testing agents use them; leave the keys blank if you are
# not exercising that pipeline.
# ─────────────────────────────────────────────────────────────────────────────
DETAILED_JSONS_PATH=data/detailed_jsons
OPENAI_API_KEY=
GOOGLE_API_KEY=
MODEL1="gemini-2.0-flash"
LITELLM_MODEL="openai/gpt-4o-mini"

# LangSmith tracing
LANGSMITH_TRACING="false"
LANGSMITH_ENDPOINT="https://eu.api.smith.langchain.com/"
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="Control-iQ-V2-Prototype"
